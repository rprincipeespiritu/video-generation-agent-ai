OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=cedar
# images: ilustraciones por escena; slides: láminas de texto.
VISUAL_MODE=images
IMAGE_MODEL=gpt-image-2
# Opcional: ruta a fuente TrueType, por ejemplo C:/Windows/Fonts/arial.ttf
FONT_PATH=
# Opcional: ruta a ffmpeg.exe. Si se omite, se usa PATH o el binario de imageio-ffmpeg.
FFMPEG_PATH=
